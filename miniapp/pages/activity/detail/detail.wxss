.title {
  font-size: 36rpx;
  font-weight: 600;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status {
  color: #07c160;
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  margin: 16rpx 0;
  background: #e8f8ef;
  color: #07c160;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.desc {
  display: block;
  color: #666;
  line-height: 1.6;
}

.info text {
  display: block;
  margin-bottom: 12rpx;
  color: #444;
}

.section-title {
  display: block;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.participant {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee;
}

button {
  margin-top: 24rpx;
}
