<view class="container">
  <view class="actions">
    <button class="btn-primary" size="mini" bindtap="goCreate">发布活动</button>
    <button size="mini" bindtap="goMy">我的活动</button>
  </view>

  <view class="card" wx:if="{{loading}}">
    <text class="text-muted">加载中...</text>
  </view>

  <block wx:for="{{activities}}" wx:key="id">
    <view class="card activity-card" bindtap="goDetail" data-id="{{item.id}}">
      <view class="row">
        <text class="title">{{item.title}}</text>
        <text class="status">{{item.statusText}}</text>
      </view>
      <text class="tag">{{item.sport_tag.name}}</text>
      <text class="text-muted">{{item.startText}} · {{item.address || '地点待定'}}</text>
      <view class="row bottom">
        <text class="text-muted">{{item.slotsText}}</text>
        <text class="distance" wx:if="{{item.distanceText}}">{{item.distanceText}}</text>
      </view>
    </view>
  </block>

  <view class="card empty" wx:if="{{!loading && activities.length === 0}}">
    <text>附近暂无活动，来发布第一个吧</text>
  </view>
</view>
