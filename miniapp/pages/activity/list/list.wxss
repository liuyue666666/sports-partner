.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.activity-card .title {
  font-size: 32rpx;
  font-weight: 600;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status {
  color: #07c160;
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  margin: 12rpx 0;
  background: #e8f8ef;
  color: #07c160;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.bottom {
  margin-top: 12rpx;
}

.distance {
  color: #07c160;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  color: #666;
  padding: 48rpx;
}
