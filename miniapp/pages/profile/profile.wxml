<view class="container">
  <view class="card profile-header">
    <view class="avatar"></view>
    <view class="info">
      <text class="nickname">{{isLoggedIn ? nickname || '运动达人' : '未登录'}}</text>
      <text class="text-muted">完善资料，提升匹配度</text>
    </view>
  </view>

  <button wx:if="{{!isLoggedIn}}" class="btn-primary" bindtap="goLogin">微信登录</button>

  <view class="card menu" wx:else>
    <view class="menu-item">编辑资料</view>
    <view class="menu-item">运动兴趣</view>
    <view class="menu-item">站内消息</view>
  </view>
</view>
