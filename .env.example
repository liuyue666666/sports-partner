# Application
APP_NAME=sports-partner
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production

# Server
API_HOST=0.0.0.0
API_PORT=8000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=sports_partner
MYSQL_PASSWORD=sports_partner
MYSQL_DATABASE=sports_partner

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# WeChat Mini Program (fill in when ready)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Match defaults
MATCH_DEFAULT_RADIUS_METERS=5000
MATCH_WEIGHT_DISTANCE=0.4
MATCH_WEIGHT_SPORT=0.4
MATCH_WEIGHT_TIME=0.2

# Admin (default dev credentials — change in production)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
